  "cards": [
    {
      "dot": "emerald",
      "title": "Dispatch",
      "items": [
        "Main loop picks dispatch_agents from a prompt rendered for the main audience (byte-identical to pre-P5, golden-tested)",
        "_dispatch builds one AgentContext per request (effective permission, allowed types, persona, max turns) and registers it with the thread's write log",
        "_on_dispatch_start persists the agent_dispatch message and chat_agents rows before any child runs"
      ]
    },
    {
      "dot": "violet",
      "title": "Child setup",
      "items": [
        "Each child gets its own SequencedBroadcaster channel, AgentTranscript, TodoLedger and shadow chatturn-{thread}-{agent}",
        "Tools are filtered by permission; git-mutating commands are refused by vcs_refusal before any approval",
        "Children cannot remember; recall caches are keyed per run and released at close"
      ]
    },
    {
      "dot": "rose",
      "title": "Check 1",
      "items": [
        "apply() asks the write log whether another agent promoted the path after this agent's last read",
        "Every touched file is re-seeded from the real workspace before patching, so a stale shadow never promotes"
      ]
    }
  ]

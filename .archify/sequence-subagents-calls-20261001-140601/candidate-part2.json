  "cards": [
    {
      "dot": "rose",
      "title": "Gates (1B)",
      "items": [
        "Gates stack on the thread with a gate_id and the agent's id, label and name",
        "Decision routes resolve the future for that gate_id: unknown → 404, ambiguous → 409, both benign in the extension",
        "Command and MCP callbacks return ApprovalOutcome; denial_text words user, policy and timeout denials truthfully"
      ]
    },
    {
      "dot": "orange",
      "title": "Check 2",
      "items": [
        "accept() re-checks staleness with no await before promote_files, then records the promote",
        "A stale accept restores the shadow, raises StaleWriteError, and the loop writes ✗ Not applied and keeps going"
      ]
    },
    {
      "dot": "emerald",
      "title": "Report + lifecycle",
      "items": [
        "report is the child's only terminal; open todos block it until the final turn, which appends Unfinished:",
        "format_dispatch_result returns every full report plus workspace_changes; nothing is truncated",
        "Stop cancels one child; restart reaps orphans; rewind deletes rewound children and their memory"
      ]
    }
  ]
